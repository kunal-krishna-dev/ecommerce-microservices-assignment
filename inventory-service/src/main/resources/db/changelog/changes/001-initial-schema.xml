<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <!-- ChangeSet 1: Create products table -->
    <changeSet id="001-create-products" author="kunal">

        <createTable tableName="products">
            <column name="product_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="product_name" type="VARCHAR(255)"/>
        </createTable>

    </changeSet>


    <!-- ChangeSet 2: Create inventory_batches table -->
    <changeSet id="002-create-inventory-batches" author="kunal">

        <createTable tableName="inventory_batches">

            <column name="batch_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="product_id" type="BIGINT"/>

            <column name="quantity" type="INT"/>

            <column name="expiry_date" type="DATE"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="inventory_batches"
                baseColumnNames="product_id"
                constraintName="fk_batch_product"
                referencedTableName="products"
                referencedColumnNames="product_id"/>

    </changeSet>


    <!-- ChangeSet 3: Load CSV Data -->
    <changeSet id="003-load-products" author="kunal">

        <loadData
                file="data/products_data.csv"
                tableName="products"
                separator=","
                encoding="UTF-8"/>

    </changeSet>

    <changeSet id="004-load-inventory-data" author="kunal">

        <loadData file="data/inventory_data.csv" tableName="inventory_batches">
            <column name="batch_id" type="NUMERIC"/>
            <column name="product_id" type="NUMERIC"/>
            <column name="quantity" type="NUMERIC"/>
            <column name="expiry_date" type="DATE"/>
            <column name="product_name" header="product_name" type="skip"/>
        </loadData>

    </changeSet>

</databaseChangeLog>